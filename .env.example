# ------------------------------------------------------------------------------
# unpub_next Docker Environment Configuration
# ------------------------------------------------------------------------------

# MongoDB Credentials
MONGO_USER=admin
MONGO_PASSWORD=secretpassword
MONGO_DB=dart_pub
MONGO_EXPOSED_PORT=27017

# Alternatively, set the full MongoDB URI:
# MONGO_URL=mongodb://admin:secretpassword@mongo:27017/dart_pub?authSource=admin
# DB_URL=mongodb://admin:secretpassword@mongo:27017/dart_pub

# Wait System (docker-compose-wait)
# WAIT_HOSTS=mongo:27017
# WAIT_HOSTS_TIMEOUT=30

# Override Uploader Email for all published packages
UNPUB_OVERRIDE_UPLOADER_EMAIL=fake-uploader@unpub.local

# Server Settings
UNPUB_PORT=4000
UNPUB_PROXY_ORIGIN=http://localhost:4000
